{
  // README-heavy repository: templates intentionally contain inline HTML,
  // long badge lines, repeated section names across variants, and HTML
  // comments used as authoring guidance.
  "config": {
    "MD013": false, // line length
    "MD024": false, // duplicate headings (variants reuse section names)
    "MD033": false, // inline HTML (centered heroes, grids, <details>)
    "MD034": false, // bare URLs (badge and quick-start blocks)
    "MD036": false, // emphasis used as a pseudo-heading in templates
    "MD040": false, // fenced code blocks without a language (directory trees)
    "MD041": false  // first line is not always a heading (hero images)
  },
  "globs": ["**/*.md", "**/.*/**/*.md"],
  "ignores": ["node_modules/**", ".git/**", ".freebuff/**"]
}
